# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
!.env.example
!.env.local.example
/sbom.cdx.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python bytecode cache
__pycache__/

# AWS SAM build cache
.aws-sam/

# Orchestrator runtime output (Phase 11) - not source, regenerated each run
infra/orchestrator/state/*.json

# Claude Code agent tooling (isolated worktrees for background sub-agents)
.claude/

# Local AWS account/credential context (Phase 1) - never commit account IDs
# or credential material
spec/.aws-context.md
